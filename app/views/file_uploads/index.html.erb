<% if notice %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<h1>Your Files</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>File List</h2>
  <%= link_to 'Upload New File', new_file_upload_path, class: 'btn btn-primary' %>
</div>

<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @file_uploads.each do |file| %>
      <tr>
        <td><%= file.title %></td>
        <td><%= file.description %></td>
        <td>
          <%= link_to 'Delete', file_upload_path(file), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm' %>
        </td>
      </tr>
    <% end %>
    <% if @file_uploads.empty? %>
        <tr>
          <td colspan="3" class="text-center">No files uploaded yet.</td>
        </tr>
    <% end %>
  </tbody>
</table>

<style>
/* You can put custom styles here if needed, but Bootstrap provides most of the styling */
.table-responsive {
    overflow-x: auto;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
